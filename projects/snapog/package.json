{
  "name": "snapog",
  "version": "0.1.0",
  "description": "OG image generation API — fast, cached, hosted on Cloudflare Workers",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply snapog-db --local",
    "db:remote": "wrangler d1 migrations apply snapog-db",
    "staging:deploy": "wrangler deploy --env staging"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "workers-og": "^0.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.102.0"
  },
  "allowScripts": {
    "esbuild@0.17.19": true,
    "sharp@0.33.5": true,
    "workerd@1.20250718.0": true
  }
}
